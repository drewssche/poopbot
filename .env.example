BOT_TOKEN=PASTE_TOKEN_HERE
BOT_OWNER_ID=
STARTUP_DELETE_WEBHOOK=true
DROP_PENDING_UPDATES_ON_START=false
HEARTBEAT_INTERVAL_SEC=60
HEARTBEAT_STALE_SEC=300
WEBHOOK_GUARD_ENABLED=true
WEBHOOK_GUARD_INTERVAL_SEC=180
POLLING_GUARD_ENABLED=true
POLLING_GUARD_PENDING_THRESHOLD=5
HANDLED_RATE_LOG_INTERVAL_SEC=300
POLLING_GUARD_INTERVAL_SEC=60
POLLING_GUARD_REQUEST_TIMEOUT_SEC=10
POLLING_GUARD_NETWORK_FAILURES_TO_RESTART=5
SCHEDULER_CHAT_THROTTLE_SEC=0.2

POSTGRES_DB=poopbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/poopbot
